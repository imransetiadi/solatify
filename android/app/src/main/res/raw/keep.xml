<?xml version="1.0" encoding="utf-8"?>
<!-- Resource shrinking in release builds removed audio_service's media
     control icons (they are looked up by name at runtime), so the Quran
     playback notification could not be built ("You must specify an icon
     resource id to build a CustomAction"). Without that notification the
     foreground service never started and Android muted background playback. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@mipmap/ic_launcher" />
